# WalletConnect / Reown project id — get one free at https://cloud.reown.com
# Injected wallets (MetaMask, Rabby) work without it; WalletConnect QR needs it.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional RPC overrides (sensible public defaults are used if blank)
VITE_SEPOLIA_RPC=
VITE_UNICHAIN_RPC=

# ── Supabase (off-chain event index → leaderboards/charts beyond the ~32h log window) ──
# Public read client (safe to ship to the browser). Dashboard → Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# SERVER-ONLY. Used by api/index-events.js to write past RLS. NEVER prefix with VITE_
# (that would bundle it into the browser). Add it in Vercel → Settings → Env Vars too.
SUPABASE_SERVICE_ROLE_KEY=
